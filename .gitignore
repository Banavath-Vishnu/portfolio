# ==============================================================================
# SECRETS & ENVIRONMENT VARIABLES (CRITICAL)
# ==============================================================================
# Ignore all environment files containing live credentials, passwords, and tokens
.env
.env.*
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Explicitly allow the template/example env file to be tracked in git
!.env.example

# Cloudflare Wrangler local secrets & dev variables (generated / manual)
.dev.vars
.dev.vars.*

# Secret dumps, private keys, and TLS/SSL certificates
secrets.json
*-secrets.json
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Cloud service accounts, OAuth client secrets, and Firebase credentials
service-account*.json
*-credentials.json
credentials.json
client_secret*.json
firebase-adminsdk*.json
gcp-key*.json
aws-credentials*

# Package manager credentials
.npmrc
.yarnrc

# ==============================================================================
# SEARCH ENGINE & SITE VERIFICATION TOKENS
# ==============================================================================
# HTML / XML file verification tokens for Google Search Console, Bing, Yandex
google*.html
public/google*.html
BingSiteAuth.xml
public/BingSiteAuth.xml
yandex_*.html
public/yandex_*.html
*verification*.html
*verification*.txt

# ==============================================================================
# DATA EXPORTS, SUBSCRIBERS & MESSAGES
# ==============================================================================
# Prevent accidental tracking of exported newsletter subscribers or inbox messages
subscribers.csv
subscribers.json
messages.csv
messages.json
contacts.csv
contacts.json
export*.csv
export*.json

# ==============================================================================
# HOSTING & CLOUDFLARE ARTIFACTS
# ==============================================================================
# Cloudflare Wrangler CLI state (contains local D1 SQLite databases, credentials, state)
.wrangler/

# OpenNext Cloudflare adapter build output and bundled worker
.open-next/

# Generated Cloudflare configuration files (auto-generated from .env.local by scripts/cf-config.mjs)
wrangler.json
wrangler.jsonc
wrangler.dev.json
wrangler.dev.jsonc
wrangler.toml

# Cloudflare Pages / Workers CLI local state
.cloudflare/

# Other hosting providers local state
.vercel/
.netlify/

# ==============================================================================
# GENERATED VENDOR & STATIC ASSETS
# ==============================================================================
# Vendor chunk folder generated by scripts/vendor-mermaid.mjs
public/vendor/

# ==============================================================================
# DEPENDENCIES & BUILD OUTPUTS
# ==============================================================================
# Node dependencies
node_modules/
.pnp
.pnp.js

# Next.js build cache and output
.next/
out/
dist/
build/

# Turbopack cache
.turbo/

# ==============================================================================
# LOCAL DATABASES, DUMPS & STORAGE
# ==============================================================================
# Local SQLite database files, dumps, journals, and WAL files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
*.sql
*.dump

# Database backup archives
*.tar
*.tar.gz
*.zip
*.7z
*.rar

# ==============================================================================
# LOGS & DEBUGGING
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# TESTING & COVERAGE
# ==============================================================================
coverage/
.nyc_output/
test-results/
playwright-report/

# ==============================================================================
# OS & SYSTEM ARTIFACTS
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==============================================================================
# IDE & EDITORS
# ==============================================================================
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# VS Code (ignore user/workspace state, allow recommended extensions if added)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ==============================================================================
# PERSONAL & SCRATCH NOTES
# ==============================================================================
SESSION-NOTES.txt
scratch/
private/
*.tmp
*.temp
*.bak
*.backup
