# Copy to .env.local and fill in. Run `npm run cf:config` after editing.

# Site — SEO settings and optional Google Analytics 4 id.
# Your live address for SEO (canonical URLs, sitemap, social previews), e.g. https://vishnu.dev
# Leave empty to use whatever address the site is served from (e.g. your *.workers.dev URL).
SITE_URL=
# Search engine ownership checks: paste the "content" value of the meta tag each one gives you.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Visitor analytics (both optional, public IDs). Google Analytics 4 "G-XXXXXXX" (Admin > Data streams),
# Microsoft Clarity project ID (clarity.microsoft.com > Settings > Overview). Rebuild/redeploy after changing.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Admin login. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# For production, upload both with `npm run cf:secrets`.
ADMIN_PASSWORD=
SESSION_SECRET=

# Cloudflare
CF_ACCOUNT_ID=                       # optional; Wrangler asks if you have several accounts
CF_WORKER_NAME=vishnu-portfolio      # the Worker (site) name → https://<name>.<you>.workers.dev
CF_D1_DATABASE_NAME=vishnu-portfolio-db
CF_D1_DATABASE_ID=                   # from `npx wrangler d1 create vishnu-portfolio-db`

# Images — Cloudinary (dashboard → Settings → API Keys). Leave empty to turn uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vishnu-portfolio

# Timezone for post dates and scheduled publishing times (IANA name, e.g. Asia/Kolkata, Europe/London).
SITE_TIMEZONE=Asia/Kolkata
